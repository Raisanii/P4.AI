# P4.AI — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Turso (libSQL) — see https://turso.tech
DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN=""

# NextAuth.js v5
NEXTAUTH_SECRET="" # generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# Baileys WhatsApp bot (WABOT-01). Session dir for multi-file auth state.
# Persists across restarts so the bot reconnects without re-pairing.
BAILEYS_SESSION_PATH="./wa-session"

# Daily class digest (§7.15). WIB hour to send the daily report to secretaries.
# Default: 17 (5pm WIB). Integer 0–23. Set lower for testing.
DIGEST_SEND_HOUR=17
